{
  "name": "cordantry",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "build": "pnpm --filter @cordantry/dashboard build && pnpm --filter @cordantry/desktop build",
    "build:website": "pnpm --filter @cordantry/website build",
    "desktop": "pnpm build && pnpm --filter @cordantry/desktop dev",
    "dist": "pnpm --filter @cordantry/dashboard build && pnpm --filter @cordantry/desktop dist",
    "dev": "pnpm -r --parallel --if-present dev",
    "smoke:execution-health": "vitest run apps/cli/src/commands/executionHealth.smoke.test.ts",
    "smoke:desktop": "pnpm build && node scripts/desktop-worker-smoke.mjs",
    "sample:execution-health": "tsx scripts/execution-health-samples.ts",
    "smoke:mock": "tsx scripts/mock-smoke.ts",
    "smoke:real-agent": "tsx scripts/real-agent-smoke.ts",
    "smoke:real-planning": "tsx scripts/real-planning-contract-smoke.ts",
    "test": "vitest run --passWithNoTests",
    "typecheck": "pnpm -r --if-present typecheck",
    "lint": "pnpm -r --if-present lint"
  },
  "devDependencies": {
    "@cordantry/core": "workspace:*",
    "@cordantry/server": "workspace:*",
    "tsx": "^4.23.12",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  }
}
